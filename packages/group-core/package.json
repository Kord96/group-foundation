{
  "name": "@group-foundation/group-core",
  "version": "0.3.0",
  "description": "Portable MLS custody and staged group mechanics",
  "type": "module",
  "sideEffects": false,
  "license": "AGPL-3.0-or-later",
  "files": [
    "dist",
    "generated",
    "spec",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./encoding": {
      "types": "./dist/encoding.d.ts",
      "import": "./dist/encoding.js"
    },
    "./testing": {
      "types": "./dist/testing/in-memory.d.ts",
      "import": "./dist/testing/in-memory.js"
    },
    "./native": {
      "types": "./generated/foundation_group.d.ts",
      "import": "./generated/foundation_group.js"
    },
    "./native-wasm": "./generated/foundation_group_bg.wasm"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:wasm": "./rust/build-wasm.sh",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:rust": "cargo test --locked --manifest-path ../../Cargo.toml --package group-foundation-core --features wasm",
    "test:browser": "node tests/product-binding-browser.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
